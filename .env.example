# ─── Site ──────────────────────────────────────────────────────────────────
# The canonical origin. Drives canonical tags, og:url, sitemap.xml, robots.txt
# and llms.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.universalvirtualsupport.com

# ─── Enquiry form delivery (SMTP) ──────────────────────────────────────────
# Required in production. Without these the form returns 503 and tells the
# visitor to email directly — it never reports success for a message it did
# not send.
#
# Use an APP PASSWORD, not the account password.
#   Google Workspace : smtp.gmail.com          port 465
#   Microsoft 365    : smtp.office365.com      port 587
#   cPanel / shared  : mail.yourdomain.com     port 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=admin@universalvirtualsupport.com
SMTP_PASSWORD=

# Optional. Defaults to SMTP_USER.
SMTP_FROM=

# Optional. Defaults to the address in content/company.js.
ENQUIRY_TO=admin@universalvirtualsupport.com
